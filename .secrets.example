# Cloudflare Pages deploy secrets — checklist, not a config file.
#
# GitHub Actions does NOT read this file. It exists only so you know exactly
# which two values to fill in and where to put them. Never commit real
# values here or anywhere else in this repo.
#
# Where to add the real values:
#   https://github.com/lillyostad-ctrl/eva-claude/settings/secrets/actions
#   -> "New repository secret" for each line below.
#
# Where to get each value: see DEPLOY.md.

CLOUDFLARE_API_TOKEN=   # from dash.cloudflare.com/profile/api-tokens (Account > Cloudflare Pages > Edit)
CLOUDFLARE_ACCOUNT_ID=  # from your Cloudflare dashboard Overview page, right sidebar
